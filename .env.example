# Scale Flow Sales OS 3.0 — CRM V2 Backend Environment Example (Checkpoint B1A)
# Copy to `.env` for local development or configure in Hostinger hPanel -> Environment Variables.
# NEVER commit `.env` or any file containing real credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database — Managed MySQL 8 / MariaDB 10.6+ (Activated in B2)
# IMPORTANT for Hostinger Node 18/20/22/24: use `127.0.0.1` instead of `localhost`
# to prevent IPv6 `::1` lookup rejections (`Access denied for user ...@'::1'`).
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_LIMIT=8
DB_SSL_MODE=disabled
# Optional alternative single-string DSN for local CLI tools:
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/db_name

# ---------------------------------------------------------------------------
# Private Payment-Proof Storage (Activated in B3)
# On Hostinger managed hosting, store files OUTSIDE `public_html` and OUTSIDE
# ephemeral `hbuilds/current/nodejs` if persistent sibling storage is verified;
# otherwise switch PROOF_STORAGE_DRIVER=object-storage.
# ---------------------------------------------------------------------------
PROOF_STORAGE_DRIVER=local-fs
PROOF_STORAGE_DIR=.data/private-proofs

# ---------------------------------------------------------------------------
# AI Provider Mode (B1A uses deterministic Demo mode only)
# ---------------------------------------------------------------------------
AI_PROVIDER=demo

# ---------------------------------------------------------------------------
# Owner Authentication & Session Policy (Checkpoint B1B)
# No default/hardcoded Owner credentials exist in source control.
# Use `npm run auth:bootstrap` to provision an Owner password hash at runtime.
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=sf_session
SESSION_IDLE_TTL_SECONDS=43200
SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
# Set AUTH_TRUST_PROXY=true when running behind Hostinger/reverse-proxy HTTPS
AUTH_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Future Checkpoints (NOT active in B1B — do not populate until B5)
# ---------------------------------------------------------------------------
# [B5]  OPENROUTER_API_KEY=
# [B5]  OPENROUTER_MODEL=
