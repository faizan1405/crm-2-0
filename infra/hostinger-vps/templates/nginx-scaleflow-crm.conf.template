# Scale Flow Sales OS 3.0 — Nginx TLS Reverse Proxy Template (B11C Phase 1 Hardened)
# TARGET PATH ON VPS: /etc/nginx/sites-available/scaleflow-crm.conf
# Replace __DOMAIN__ with Owner-approved domain:
#   Proposed staging:           staging-v2.joinscaleflow.in
#   Proposed future production: v2.crm.joinscaleflow.in
# HARD SAFETY RULE: NEVER set __DOMAIN__ to crm.joinscaleflow.in (CRM V1).

# Drop stray IP/unknown Host requests on HTTP
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    server_tokens off;

    # Allow Let's Encrypt ACME HTTP-01 validation before TLS redirect
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Note: Ubuntu 24.04 ships Nginx 1.24.0 where `listen 443 ssl http2` is standard.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    server_tokens off;

    # Certbot / Let's Encrypt certificates (self-contained TLS settings; avoids certbot-nginx helper file coupling)
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ScaleFlowTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Upload cap slightly above B11A MAX_PROOF_BYTES (10 MiB) to allow multipart headers
    client_max_body_size 12m;
    client_body_timeout 30s;
    send_timeout 60s;

    access_log /var/log/scaleflow-crm/nginx-access.log;
    error_log  /var/log/scaleflow-crm/nginx-error.log warn;

    # Prevent Host-header poisoning behind SNI
    if ($host != "__DOMAIN__") {
        return 444;
    }

    # TLS transport enforcement (application routes set X-Frame-Options, CSP, and Cache-Control)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Explicitly reject dotfiles (.env, .git, etc.) except ACME challenge
    location ~ /\.(?!well-known) {
        return 404;
    }

    # Explicitly deny any direct path probes resembling private storage, backups, or release folders
    location ~* ^/(private-proofs|private_proofs|staging|proofs|var/lib|opt/scaleflow-crm|etc/scaleflow-crm|backups|crm\.env) {
        return 404;
    }

    # Reverse proxy all CRM SSR pages and /api/* requests to local loopback Nitro
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
