# Scale Flow Sales OS 3.0 — Hostinger VPS Production/Staging Environment Template
# TARGET PATH ON VPS: /etc/scaleflow-crm/crm.env  (chmod 0640, chown root:crmapp)
# DO NOT commit a populated copy with real secrets. NEVER set CRM V1 (crm.joinscaleflow.in) here.
# Checkpoint: B11C-PRE Local Deployment Preparation

# -----------------------------------------------------------------------------
# 1. Runtime & Reverse Proxy Binding (Nginx -> 127.0.0.1:3000)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NITRO_PORT=3000
HOST=127.0.0.1
NITRO_HOST=127.0.0.1

# Proposed domains ONLY (confirm with Owner before DNS creation):
#   Staging:           https://staging-v2.joinscaleflow.in
#   Future production: https://v2.crm.joinscaleflow.in
# NEVER set https://crm.joinscaleflow.in (CRM V1 must remain isolated).
APP_ORIGIN=https://__PROPOSED_SUBDOMAIN_REPLACE_ME__
BUSINESS_TIMEZONE=Asia/Kolkata
AUTH_TRUST_PROXY=true

# -----------------------------------------------------------------------------
# 2. Local MariaDB 11.4 Database (Loopback IPv4 only; port 3306 closed externally)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=__REPLACE_DB_NAME_E_G_scaleflow_crm_staging__
DB_USER=__REPLACE_DB_USER_E_G_crm_app__
DB_PASSWORD=__REPLACE_WITH_32_PLUS_CHAR_CSPRNG_PASSWORD__
DB_POOL_LIMIT=8
DB_SSL_MODE=disabled

# -----------------------------------------------------------------------------
# 3. Private Payment-Proof Storage (B11A Fail-Closed Contract)
# Note: LocalFsProofStorage (src/server/storage/proofStorage.server.ts) stores:
#   - permanent proofs at: <PROOF_STORAGE_DIR>/proofs/prf_<proofId>.<ext>
#   - upload temp files at: <PROOF_STORAGE_DIR>/staging/tmp_<ts>_<uuid>.tmp
# Operational staging workspace also exists at /var/lib/scaleflow-crm/staging/ (0700 crmapp).
# CRITICAL: Keep PROOF_PRODUCTION_DURABLE_CONFIRMED=false until ALL 20 staging
# durability tests (scripts/b11c-staging-durability-harness.mjs) pass and Owner approves!
# -----------------------------------------------------------------------------
PROOF_STORAGE_DRIVER=hostinger-private-fs
PROOF_STORAGE_DIR=/var/lib/scaleflow-crm/private-proofs
PROOF_PRODUCTION_DURABLE_CONFIRMED=false

# -----------------------------------------------------------------------------
# 4. Owner Authentication & Session Controls
# Generate AUTH_SECRET via: openssl rand -hex 32
# Provision Owner account via: npm run auth:bootstrap
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=sf_session
SESSION_IDLE_TTL_SECONDS=43200
SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
AUTH_SECRET=__REPLACE_WITH_64_HEX_CHAR_CSPRNG_SECRET__

# -----------------------------------------------------------------------------
# 5. Feature & Safety Lockouts (MUST stay disabled on VPS)
# Never define AUTOMATION_TEST_DB_ALLOWLIST on staging/production VPS.
# -----------------------------------------------------------------------------
DEV_LEAD_PILOT=false
AI_PROVIDER=demo

# -----------------------------------------------------------------------------
# 6. Encrypted Off-VPS Backup Parameters (Public key ONLY on VPS!)
# NEVER place AGE-SECRET-KEY-... or backup decryption passphrases on this VPS.
# Off-VPS destination remains an explicit unresolved Owner decision prior to B11C go-live.
# -----------------------------------------------------------------------------
BACKUP_AGE_RECIPIENT=age1__REPLACE_WITH_OWNER_PUBLIC_AGE_KEY_ONLY__
BACKUP_ARCHIVE_DIR=/var/backups/scaleflow-crm
BACKUP_LOG_DIR=/var/log/scaleflow-crm
BACKUP_RETENTION_DAYS=30
BACKUP_OFF_VPS_STATUS=UNRESOLVED_OWNER_DECISION
